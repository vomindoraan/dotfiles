# Bash
alias catn='tail -n +1'
alias diff='diff --color=auto'
alias errcho='>&2 echo'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'
alias grep='grep --color=auto'
alias killjobs='jobs -p | xargs kill >/dev/null'
alias ls='ls --color=auto'
alias l='ls -F'
alias la='ls -AF'
alias ll='ls -lahF'
alias lr='ls -RF'
alias reload='[ -f ~/.bash_profile ] && . ~/.bash_profile || . ~/.profile'

# Binaries
alias py='python'
alias ipy='ipython'
alias serve='python -m http.server'
alias vsdev='exec cmd.exe "/c VsDevCmd.bat & bash"'

# Django
alias m='python manage.py'
alias ma='python manage.py startapp'
alias md='python manage.py dbshell'
alias mdd='python manage.py dumpdata'
alias mf='python manage.py flush'
alias mld='python manage.py loaddata'
alias mm='python manage.py migrate'
alias mmm='python manage.py makemigrations'
alias mr='python manage.py runserver'
alias mrd='python manage.py runserver --ipdb'
alias ms='python manage.py shell'
alias msm='python manage.py showmigrations'
alias mt='python manage.py test'

# Docker
alias d='docker'
alias da='docker attach'
alias db='docker build'
alias dbf='docker build -f'
alias dbt='docker build -t'
alias dbp='docker builder prune'
alias dbpa='docker builder prune -a'
alias de='docker exec'
alias di='docker images'
alias dia='docker images -a'
alias diq='docker images -q'
alias dip='docker image prune'
alias dipa='docker image prune -a'
alias dk='docker kill'
alias dka='docker kill $(docker ps -q)'
alias dl='docker logs'
alias dp='docker ps'
alias dpa='docker ps -a'
alias dpp='docker container prune'
alias dpq='docker ps -q'
alias dr='docker run --rm'
alias dri='docker run --rm -it'
alias drip='docker run --rm -it -p'
alias driv='docker run --rm -it -v'
alias drp='docker run --rm -p'
alias drv='docker run --rm -v'
alias drm='docker rm'
alias drma='docker rm $(docker ps -aq)'
alias drmi='docker rmi'
alias drmI='docker rmi --force'
alias drn='docker rename'
alias drs='docker restart'
alias ds='docker start'
alias dst='docker stop'
alias dv='docker volume ls'
alias dvp='docker volume prune'
alias dvpa='docker volume prune -a'

# Docker Compose
alias dc='docker-compose'
alias dcb='docker-compose build'
alias dcd='docker-compose down --remove-orphans'
alias dcdi='docker-compose down --remove-orphans --rmi all'
alias dce='docker-compose exec'
alias dci='docker-compose images'
alias dck='docker-compose kill'
alias dcl='docker-compose logs'
alias dclf='docker-compose logs -f'
alias dcp='docker-compose ps'
alias dcr='docker-compose run --rm'
alias dcrp='docker-compose run --rm --service-ports'
alias dcrs='docker-compose restart'
alias dcrm='docker-compose rm'
alias dcs='docker-compose start'
alias dcst='docker-compose stop'
alias dcu='docker-compose up -d'
alias dcub='docker-compose up -d --build'
alias dcuw='docker-compose up -w'
alias dcw='docker-compose watch'

